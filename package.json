{
  "name": "tuiaux",
  "version": "0.0.0",
  "description": "Your CI pipelines, live in your terminal. A TUI for GitHub Actions and GitLab CI, built with OpenTUI.",
  "keywords": [
    "tui",
    "ci",
    "cd",
    "github-actions",
    "gitlab-ci",
    "pipelines",
    "terminal",
    "opentui",
    "devops"
  ],
  "license": "MIT",
  "author": {
    "name": "Satisfies Labs",
    "url": "https://github.com/satisfies-labs"
  },
  "homepage": "https://github.com/satisfies-labs/tuiaux#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satisfies-labs/tuiaux.git"
  },
  "bugs": {
    "url": "https://github.com/satisfies-labs/tuiaux/issues"
  },
  "type": "module",
  "bin": {
    "tuiaux": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "demo": "bun run src/cli/index.ts --demo",
    "demo:gif": "vhs docs/demo.tape",
    "build": "bun build src/cli/index.ts --target bun --packages external --outfile dist/cli.js --minify",
    "compile": "bun run scripts/compile.ts",
    "snapshot": "bun --preload ./tests/setup.ts scripts/snapshot.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "format": "oxlint --fix && oxfmt",
    "check": "bun run lint && bun run typecheck && bun run test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "dependencies": {
    "@opentui/core": "0.9.9",
    "@opentui/react": "0.9.9",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@octokit/openapi-types": "^29.0.1",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.3",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "^7.0.2"
  }
}
