{
  "name": "tuiaux",
  "version": "0.0.0",
  "private": true,
  "description": "Your CI pipelines, live in your terminal. A TUI for GitHub Actions and GitLab CI, built with OpenTUI.",
  "keywords": [
    "tui",
    "ci",
    "cd",
    "github-actions",
    "gitlab-ci",
    "pipelines",
    "terminal",
    "opentui",
    "devops"
  ],
  "license": "MIT",
  "author": {
    "name": "Satisfies Labs",
    "url": "https://github.com/satisfies-labs"
  },
  "homepage": "https://github.com/satisfies-labs/tuiaux#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satisfies-labs/tuiaux.git"
  },
  "bugs": {
    "url": "https://github.com/satisfies-labs/tuiaux/issues"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "scripts": {
    "dev": "bun run src/main.ts",
    "compile": "bun run scripts/compile.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "lint": "oxlint src tests scripts && effect-tsgo patch --no-typescript --oxlint && oxlint --config .oxlintrc.effect.json --deny-warnings src tests scripts && oxfmt --check",
    "format": "oxfmt",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@effect/atom-react": "4.1.7",
    "@effect/platform-bun": "4.1.7",
    "@opentui/core": "0.9.9",
    "@opentui/react": "0.9.9",
    "effect": "4.1.7",
    "react": "^19.3.1",
    "scheduler": "0.27.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.7",
    "@oxlint/plugins": "1.95.0",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.3",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "^7.0.2"
  }
}
