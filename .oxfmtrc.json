{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": false,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "printWidth": 80,
  "sortImports": {
    "ignoreCase": false,
    "customGroups": [
      { "groupName": "scoped", "elementNamePattern": ["@*", "@*/**"] }
    ],
    "groups": [
      ["builtin", "external"],
      "scoped",
      ["parent", "sibling", "index"],
      "unknown"
    ]
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "tests/fixtures",
    "docs/design",
    "assets",
    "*.md",
    "*.toml",
    "*.tsbuildinfo",
    "bun.lock",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ]
}
