{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 110,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortImports": { "newlinesBetween": false },
  "sortPackageJson": false,
  "ignorePatterns": ["dist", "node_modules", "tests/fixtures", "docs/design", "assets", "*.md", "*.toml"]
}
